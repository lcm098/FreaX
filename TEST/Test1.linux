mem slot[]  _1byteU ages1 = {1, 2, 3}  // size comes from the initializer
mem slot[5] _1byteU ages2 = {1, 2}     // size 5, the rest is zero
mem slot[5] _1byteU ages3              //  size 5, all zero (no initializer needed)
mem const[] _1byteU ages4 = {1, 2}     //  elements cannot be changed

console ages1
console ages2
console ages3
console ages4

// ages4[0] = 55
